# Builder image
FROM quay.io/jupyter/minimal-notebook:latest AS builder

USER root
WORKDIR /tmp

RUN apt-get -y update && apt-get -y install debian-keyring debian-archive-keyring apt-transport-https build-essential gcc g++ && rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# Go
RUN curl -fsSL https://go.dev/dl/go1.25.4.linux-amd64.tar.gz | tar -C /usr/local -xzf -

# XCaddy
RUN curl -1sLf 'https://dl.cloudsmith.io/public/caddy/xcaddy/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-xcaddy-archive-keyring.gpg && \
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/xcaddy/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-xcaddy.list && \
  sudo apt-get -y update && apt-get -y install xcaddy && rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# Build and install caddy
RUN PATH=/usr/local/go/bin:${PATH} xcaddy build --with=github.com/caddyserver/replace-response --output=/usr/local/bin/caddy && rm -rf /home/jovyan/.cache

# btop
RUN arch=$(arch | sed s/aarch64/aarch64/ | sed s/x86_64/x86_64/) && curl -o btop.tbz -L https://github.com/aristocratos/btop/releases/download/v1.4.5/btop-${arch}-linux-musl.tbz && \
  tar -C /tmp -xvf btop.tbz && \
  cd /tmp/btop && make install && \
  rm -rf /tmp/btop && \
  rm -f btop.tbz

# build our theme
RUN mamba install -y -c conda-forge 'nodejs>=24,<25'

WORKDIR /src
COPY ./share/theme .

# Use BuildKit cache mounts so jlpm/pip downloads survive across builds
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/usr/local/share/.cache/yarn \
    pip install --break-system-packages build \
    && python3 -m build --wheel


FROM quay.io/jupyter/minimal-notebook:latest AS manpages

USER root
RUN yes | unminimize; rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# Main Image
FROM quay.io/jupyter/minimal-notebook:latest

ARG UV_INDEX=https://pypi.org/simple
ENV UV_LINK_MODE=copy

USER root
WORKDIR /tmp

# Reinstall man pages
COPY --from=manpages /usr/share/man /usr/share/man

RUN apt-get -y update && \
  apt-get -y --no-install-recommends install debian-keyring debian-archive-keyring apt-transport-https build-essential gcc g++ rsync zsh jq tmux psmisc acl libnss-sss libpam-sss sssd-tools man man-db && \
  rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# RUN sed -i 's:^path-exclude=/usr/share/man:#path-exclude=/usr/share/man:' /etc/dpkg/dpkg.cfg.d/excludes && \
#   apt-get update && \
#   apt-get install -y --no-install-recommends man manpages-posix man-db && \
#   rm -rf /var/cache/apt/archives /var/lib/apt/lists/* && \
#   rm -f /usr/bin/man && \
#   dpkg-divert --quiet --remove --rename /usr/bin/man

# Eza
RUN curl -o eza.tgz -L https://github.com/eza-community/eza/releases/download/v0.23.4/eza_$(arch)-unknown-linux-gnu.tar.gz && \
  tar -C /usr/local/bin -xvf eza.tgz && \
  rm -f eza.tgz

# RipGrep
RUN arch=$(arch | sed s/aarch64/aarch64-unknown-linux-gnu/ | sed s/x86_64/x86_64-unknown-linux-musl/) && curl -o ripgrep.tgz -L https://github.com/BurntSushi/ripgrep/releases/download/15.1.0/ripgrep-15.1.0-${arch}.tar.gz && \
  mkdir -p /opt/ripgrep && \
  tar -C /opt/ripgrep -xvf ripgrep.tgz --strip-components=1 && \
  ln -s /opt/ripgrep/rg /usr/local/bin && \
  rm -f ripgrep.tgz

# btop
COPY --from=builder /usr/local/bin/btop /usr/local/bin/btop

# Neovim
RUN arch=$(arch | sed s/aarch64/arm64/ | sed s/x86_64/x86_64/) && curl -o nvim.tgz -L https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${arch}.tar.gz && \
  mkdir -p /opt/nvim && \
  tar -C /opt/nvim -xzf nvim.tgz --strip-components=1 && \
  ln -s /opt/nvim/bin/nvim /usr/local/bin && \
  rm -f nvim.tgz

# Caddy
COPY --from=builder /usr/local/bin/caddy /usr/local/bin/caddy

# UV
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh

# FZF
RUN curl -LsSf https://github.com/junegunn/fzf/releases/download/v0.66.1/fzf-0.66.1-linux_amd64.tar.gz | tar -xzf - -C /usr/local/bin

# Antidote
RUN git clone --depth=1 https://github.com/mattmc3/antidote.git /opt/antidote

# Zoxide
RUN curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh -s -- --bin-dir /usr/local/bin --man-dir /usr/local/share/man

# Cleanup APT cache and working dirs
RUN rm -rf /var/cache/apt/archives /var/lib/apt/lists/* /tmp/*

# Add directory and correct permissions for additional node installs and uv cache
RUN mkdir -p /opt/noderoots && chown $NB_USER:users /opt/noderoots && chmod g+ws /opt/noderoots && \
  mkdir -p /opt/uv && chown $NB_USER:users /opt/uv && chmod g+ws /opt/uv

RUN chsh -s /bin/zsh $NB_USER

RUN git config --global --add safe.directory /opt/repo

USER $NB_USER
WORKDIR /home/$NB_USER

# Curvenote and other node packages
RUN mamba install -y -c conda-forge 'nodejs>=24,<25' && \
  npm install -g curvenote@0.15.0 nodemon unified-language-server && \
  npm cache clean --force && \
  mamba clean --all && \
  rm -rf /tmp/*

# Pre-install pip packages so we can have them cached as a docker layer
# and only add updates based on the latest hub repo

COPY bin/setup-stub.sh /usr/local/bin/before-notebook.d/setup-stub.sh
COPY --chown=$NB_USER:users --chmod=g+ws . /opt/repo/
COPY --chown=$NB_USER:users ./home-overlay /home/$NB_USER

# Jupyter Theme
# WORKDIR /opt/repo/share/theme
# RUN pip install --no-cache-dir -e . && jlpm build && jupyter labextension develop . --overwrite && jlpm cache clean && rm -rf /home/jovyan/.cache && rm -rf /home/jovyan/.yarn/berry/cache
COPY --from=builder --chown=$NB_USER:users /src/dist/*.whl /tmp/
RUN pip install --no-cache-dir /tmp/*.whl \
  && rm -rf /tmp/*.whl

# Python environment
RUN --mount=type=cache,target=/root/.cache/uv \
  cd /opt/repo/nucleus-env && UV_PROJECT_ENVIRONMENT=/opt/conda uv sync \
  && cd /opt/repo/envs/modeling && uv sync && uv run ipython kernel install --user --env VIRTUAL_ENV $(pwd)/.venv --name=Modeling

# WORKDIR /opt/repo/envs/modeling
# RUN /usr/local/bin/uv sync && /usr/local/bin/uv run ipython kernel install --user --env VIRTUAL_ENV $(pwd)/.venv --name=Modeling

# WORKDIR /home/jovyan

# Run through our startup shim so we can emit logging
CMD ["/opt/repo/bin/start-jupyter.sh"]