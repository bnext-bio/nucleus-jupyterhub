# Pinned base image: a moving `latest` tag invalidates every layer whenever
# upstream republishes. Bump this deliberately (tags are dated, YYYY-MM-DD).
ARG BASE_IMAGE=quay.io/jupyter/minimal-notebook:2026-10-05

FROM ${BASE_IMAGE} AS base

USER root

# Disable the docker-clean script that wipes apt caches after install
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
 && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
    > /etc/apt/apt.conf.d/keep-cache

# Builder image
FROM base AS builder

WORKDIR /tmp

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \ 
    apt-get -y update && apt-get -y install debian-keyring debian-archive-keyring apt-transport-https build-essential gcc g++

# Go
RUN curl -fsSL https://go.dev/dl/go1.25.4.linux-amd64.tar.gz | tar -C /usr/local -xzf -

# XCaddy
RUN curl -1sLf 'https://dl.cloudsmith.io/public/caddy/xcaddy/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-xcaddy-archive-keyring.gpg && \
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/xcaddy/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-xcaddy.list && \
  sudo apt-get -y update && apt-get -y install xcaddy && rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# Build and install caddy
RUN PATH=/usr/local/go/bin:${PATH} xcaddy build --with=github.com/caddyserver/replace-response --output=/usr/local/bin/caddy && rm -rf /home/jovyan/.cache

# btop
RUN arch=$(arch | sed s/aarch64/aarch64/ | sed s/x86_64/x86_64/) && curl -o btop.tbz -L https://github.com/aristocratos/btop/releases/download/v1.4.5/btop-${arch}-linux-musl.tbz && \
  tar -C /tmp -xvf btop.tbz && \
  cd /tmp/btop && make install && \
  rm -rf /tmp/btop && \
  rm -f btop.tbz

# build our theme
RUN --mount=type=cache,target=/opt/conda/pkgs,uid=$NB_UID,gid=$NB_GID \
    --mount=type=cache,target=/home/$NB_USER/.npm,uid=$NB_UID,gid=$NB_GID \
    mamba install -y -c conda-forge 'nodejs>=24,<25'

WORKDIR /src
COPY ./share/theme .

# Use BuildKit cache mounts so jlpm/pip downloads survive across builds
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/usr/local/share/.cache/yarn \
    pip install --break-system-packages build \
    && python3 -m build --wheel

# Build typst
# Actually, we're just going to install the binary directly way easier
# ENV CARGO_HOME=/root/.cargo \
#     CARGO_TARGET_DIR=/tmp/target \
#     PATH=/root/.cargo/bin:$PATH

# RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
#     --mount=type=cache,target=/root/.cargo/git,sharing=locked \
#     --mount=type=cache,target=/tmp/target,sharing=locked \
#     curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
#       | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path && \
#     cargo install --locked typst-cli

FROM base AS manpages

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \ 
    yes | unminimize || true

# Main Image
FROM base

WORKDIR /tmp

# Reinstall man pages
COPY --from=manpages /usr/share/man /usr/share/man

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -y update \
    && apt-get -y --no-install-recommends install debian-keyring debian-archive-keyring apt-transport-https build-essential gcc g++ rsync zsh jq tmux psmisc ffmpeg acl libnss-sss libpam-sss sssd-tools man man-db libvips42

# RUN sed -i 's:^path-exclude=/usr/share/man:#path-exclude=/usr/share/man:' /etc/dpkg/dpkg.cfg.d/excludes && \
#   apt-get update && \
#   apt-get install -y --no-install-recommends man manpages-posix man-db && \
#   rm -rf /var/cache/apt/archives /var/lib/apt/lists/* && \
#   rm -f /usr/bin/man && \
#   dpkg-divert --quiet --remove --rename /usr/bin/man

# Eza
RUN curl -o eza.tgz -L https://github.com/eza-community/eza/releases/download/v0.23.4/eza_$(arch)-unknown-linux-gnu.tar.gz && \
  tar -C /usr/local/bin -xvf eza.tgz && \
  rm -f eza.tgz

# RipGrep
RUN arch=$(arch | sed s/aarch64/aarch64-unknown-linux-gnu/ | sed s/x86_64/x86_64-unknown-linux-musl/) && curl -o ripgrep.tgz -L https://github.com/BurntSushi/ripgrep/releases/download/15.1.0/ripgrep-15.1.0-${arch}.tar.gz && \
  mkdir -p /opt/ripgrep && \
  tar -C /opt/ripgrep -xvf ripgrep.tgz --strip-components=1 && \
  ln -s /opt/ripgrep/rg /usr/local/bin && \
  rm -f ripgrep.tgz

# btop
COPY --from=builder /usr/local/bin/btop /usr/local/bin/btop

# Neovim
RUN arch=$(arch | sed s/aarch64/arm64/ | sed s/x86_64/x86_64/) && curl -o nvim.tgz -L https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${arch}.tar.gz && \
  mkdir -p /opt/nvim && \
  tar -C /opt/nvim -xzf nvim.tgz --strip-components=1 && \
  ln -s /opt/nvim/bin/nvim /usr/local/bin && \
  rm -f nvim.tgz

# Caddy
COPY --from=builder /usr/local/bin/caddy /usr/local/bin/caddy

# UV
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /usr/local/bin/

# FZF
RUN curl -LsSf https://github.com/junegunn/fzf/releases/download/v0.66.1/fzf-0.66.1-linux_amd64.tar.gz | tar -xzf - -C /usr/local/bin

# Antidote
RUN git clone --depth=1 https://github.com/mattmc3/antidote.git /opt/antidote

# Zoxide
# The installer leaves a root-owned temp dir behind, which later non-root
# `rm -rf /tmp/*` steps can't remove, so clean it up here as root.
RUN curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh -s -- --bin-dir /usr/local/bin --man-dir /usr/local/share/man \
  && rm -rf /tmp/*

# Typst
# COPY --from=builder /root/.cargo/bin/typst /usr/local/bin/typst https://github.com/typst/typst/releases/download/v0.14.2/typst-x86_64-unknown-linux-musl.tar.xz

# Add directory and correct permissions for additional node installs and uv cache
RUN mkdir -p /opt/noderoots && chown $NB_USER:users /opt/noderoots && chmod g+ws /opt/noderoots && \
  mkdir -p /opt/uv && chown $NB_USER:users /opt/uv && chmod g+ws /opt/uv && \
  mkdir -p /opt/repo && chown $NB_USER:users /opt/repo && chmod g+ws /opt/repo

RUN chsh -s /bin/zsh $NB_USER

RUN git config --global --add safe.directory /opt/repo

USER $NB_USER
WORKDIR /home/$NB_USER

# Curvenote and other node packages
RUN --mount=type=cache,target=/opt/conda/pkgs,uid=$NB_UID,gid=$NB_GID \
    --mount=type=cache,target=/home/$NB_USER/.npm,uid=$NB_UID,gid=$NB_GID \
    umask 002 \
    && mamba install -y -c conda-forge 'nodejs>=24,<25' bun \
    && npm install --prefer-offline --no-audit --no-fund -g curvenote nodemon \
    && rm -rf /tmp/*

# Jupyter Theme
COPY --from=builder --chown=$NB_USER:users /src/dist/*.whl /tmp/
RUN umask 002 \
  &&pip install --no-cache-dir /tmp/*.whl \
  && rm -rf /tmp/*.whl

# Python environment
ENV UV_LINK_MODE=copy
ENV UV_EXCLUDE_NEWER="14 days"
ARG UV_INDEX=https://pypi.org/simple
ARG EXTRA_PACKAGES

# Copy only the dependency manifests first, so the expensive install layers
# below are reused unless the locks themselves change. The rest of the repo
# is copied afterwards.
COPY --chown=$NB_USER:users nucleus-env/pyproject.toml nucleus-env/uv.lock /opt/repo/nucleus-env/
COPY --chown=$NB_USER:users envs/modeling/ /opt/repo/envs/modeling/

# Install exactly what uv.lock pins (rather than re-resolving pyproject.toml)
# into the conda base environment. --inexact keeps the base image's existing
# packages; the nucleus-env project itself is an empty metapackage, so skip it.
RUN --mount=type=cache,target=/home/$NB_USER/.cache,uid=$NB_UID,gid=$NB_GID \
  umask 002 \
  && cd /opt/repo/nucleus-env \
  && UV_PROJECT_ENVIRONMENT=/opt/conda uv sync --frozen --inexact --no-install-project

RUN --mount=type=cache,target=/home/$NB_USER/.cache,uid=$NB_UID,gid=$NB_GID \
  umask 002 \
  && cd /opt/repo/envs/modeling && uv sync --frozen && uv run ipython kernel install --user --env VIRTUAL_ENV $(pwd)/.venv --name=Modeling

RUN --mount=type=cache,target=/home/$NB_USER/.cache,uid=$NB_UID,gid=$NB_GID \
  umask 002  \
  && if [ -n "${EXTRA_PACKAGES}" ]; then uv pip install --system ${EXTRA_PACKAGES}; fi

# Claude code and AI connectors
RUN --mount=type=cache,target=/home/$NB_USER/.npm,uid=$NB_UID,gid=$NB_GID \
    umask 002 \
    && npm install --prefer-offline --no-audit --no-fund -g @agentclientprotocol/claude-agent-acp @zed-industries/codex-acp \
    && curl -fsSL https://claude.ai/install.sh | bash

# Repo contents and home overlay: cheap layers, kept last so editing scripts,
# config or the overlay does not invalidate the dependency installs above.
COPY bin/setup-stub.sh /usr/local/bin/before-notebook.d/setup-stub.sh
COPY --chown=$NB_USER:users --chmod=g+ws . /opt/repo/
COPY --chown=$NB_USER:users ./home-overlay /home/$NB_USER

# Run through our startup shim so we can emit logging
# CMD ["/opt/repo/bin/start-jupyter.sh"]
